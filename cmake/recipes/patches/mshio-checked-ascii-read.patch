+/// Reserve room for `n` entries announced by a count in the file, but no more
+/// than a fixed amount: a wrong count must not allocate memory that the file's
+/// data does not back (the reader stops at the missing values instead).
+template <typename Vector>
+void reserve_for_count(Vector& v, size_t n)
+{
+    constexpr size_t max_reserve = size_t(1) << 20;
+    v.reserve(n < max_reserve ? n : max_reserve);
+}
+
+/// Describe where reading stopped: "line N, <section>: " for the line holding
+/// the stream position `pos`, or "<section>: " when the position is unknown.
+/// When `line_text` is given it receives that line (without its line break).
+/// Rewinds the stream; only for building an error message.
+std::string describe_position(
+    std::istream& in, std::streampos pos, const std::string& section, std::string* line_text);
+
+/// Throw InvalidFormat for a section whose reader left the stream failed (a
+/// value it could not convert, or the end of the input inside the section),
+/// naming the line where reading stopped and quoting it.
+[[noreturn]] void throw_unreadable_section(std::istream& in, const std::string& section);
+
+/// Read the token after an ASCII section's values; anything but `end_marker`
+/// means the section holds more values than its counts declare.
+void expect_section_end(std::istream& in, const std::string& section, const std::string& end_marker);
+
+/// Checked reading of the values of an ASCII section.
+///
+/// Every value is one whitespace-separated token that must convert completely:
+/// an integer has no fraction, exponent or trailing characters and fits its
+/// type; a real converts in full and is finite. A token that does not, a
+/// section marker in its place or the end of the input throws InvalidFormat
+/// naming the line, the section, the token and the value that was expected.
+/// The plain `in >> value` this replaces stopped at the first character it
+/// could not use and left the stream failed, and load_msh() then looped
+/// forever looking for the end of the section.
+///
+/// Each read takes `what`, a callable returning a description of the value
+/// ("the x coordinate of node 7"); it is only called to build an error.
+class AsciiReader
+{
+public:
+    AsciiReader(std::istream& in, std::string section)
+        : m_in(in)
+        , m_section(std::move(section))
+    {}
+
+    /// An integer >= 0 (a count, an element tag, a node reference).
+    template <typename What>
+    size_t read_count(const What& what)
+    {
+        return static_cast<size_t>(read_unsigned(0, what));
+    }
+
+    /// An integer >= 1 (a node tag; Gmsh tags start at 1).
+    template <typename What>
+    size_t read_tag(const What& what)
+    {
+        return static_cast<size_t>(read_unsigned(1, what));
+    }
+
+    /// An integer in [min_value, max_value].
+    template <typename What>
+    int read_int(const What& what, int min_value = INT_MIN, int max_value = INT_MAX)
+    {
+        const Token token = next();
+        long long value = 0;
+        bool too_large = false;
+        if (token == Token::Value && parse_signed(value, too_large)) {
+            if (value < INT_MIN || value > INT_MAX) too_large = true;
+            if (!too_large && value >= min_value && value <= max_value) {
+                return static_cast<int>(value);
+            }
+        }
+        reject(token, too_large, int_kind(min_value, max_value), what());
+    }
+
+    /// A finite real number.
+    template <typename What>
+    double read_real(const What& what)
+    {
+        const Token token = next();
+        double value = 0;
+        bool too_large = false;
+        bool finite = true;
+        if (token == Token::Value && parse_real(value, too_large, finite) && !too_large &&
+            finite) {
+            return value;
+        }
+        reject(token, too_large, finite ? "a number" : "a finite number", what());
+    }
 
+    /// A name: a quoted string (std::quoted escapes) or a single word.
+    template <typename What>
+    std::string read_quoted(const What& what)
+    {
+        std::string value;
+        m_in >> std::ws;
+        const bool quoted = m_in.peek() == '"';
+        if (!(m_in >> std::quoted(value))) reject(Token::EndOfInput, false, "a name", what());
+        if (!quoted && !value.empty() && value[0] == '$') {
+            m_token = value;
+            reject(Token::SectionMarker, false, "a name", what());
+        }
+        return value;
+    }
+
+    /// "line N, <section>: " for the value read last; rewinds the stream, so
+    /// only for an error message.
+    std::string position() { return describe_position(m_in, m_in.tellg(), m_section, nullptr); }
+
+private:
+    enum class Token { Value, SectionMarker, EndOfInput };
+
+    Token next();
+    bool parse_signed(long long& value, bool& too_large) const;
+    bool parse_unsigned(unsigned long long& value, bool& too_large) const;
+    bool parse_real(double& value, bool& too_large, bool& finite) const;
+    static std::string int_kind(int min_value, int max_value);
+
+    template <typename What>
+    unsigned long long read_unsigned(unsigned long long min_value, const What& what)
+    {
+        const Token token = next();
+        unsigned long long value = 0;
+        bool too_large = false;
+        if (token == Token::Value && parse_unsigned(value, too_large) && !too_large &&
+            value >= min_value && value <= std::numeric_limits<size_t>::max()) {
+            return value;
+        }
+        reject(token,
+            too_large,
+            min_value == 0 ? "a non-negative integer" : "a positive integer",
+            what());
+    }
+
+    [[noreturn]] void reject(
+        Token token, bool too_large, const std::string& kind, const std::string& what);
+
+    std::istream& m_in;
+    std::string m_section;
+    std::string m_token;
+};
+
+} // namespace mshio
