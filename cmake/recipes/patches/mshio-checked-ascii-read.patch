+bool AsciiReader::parse_unsigned(unsigned long long& value, bool& too_large) const
+{
+    const char* c = m_token.c_str();
+    if (*c == '+') c++;
+    if (*c == '\0') return false;
+    value = 0;
+    too_large = false;
+    for (; *c != '\0'; c++) {
+        if (*c < '0' || *c > '9') return false;
+        const unsigned digit = static_cast<unsigned>(*c - '0');
+        if (value > (std::numeric_limits<unsigned long long>::max() - digit) / 10) {
+            too_large = true;
+        } else {
+            value = value * 10 + digit;
+        }
+    }
+    return true;
+}
 
+bool AsciiReader::parse_signed(long long& value, bool& too_large) const
+{
+    const bool negative = m_token[0] == '-';
+    const char* c = m_token.c_str() + ((negative || m_token[0] == '+') ? 1 : 0);
+    if (*c == '\0') return false;
+    unsigned long long magnitude = 0;
+    too_large = false;
+    for (; *c != '\0'; c++) {
+        if (*c < '0' || *c > '9') return false;
+        const unsigned digit = static_cast<unsigned>(*c - '0');
+        if (magnitude > (std::numeric_limits<unsigned long long>::max() - digit) / 10) {
+            too_large = true;
+        } else {
+            magnitude = magnitude * 10 + digit;
+        }
+    }
+    const unsigned long long limit =
+        static_cast<unsigned long long>(std::numeric_limits<long long>::max()) +
+        (negative ? 1 : 0);
+    if (too_large || magnitude > limit) {
+        too_large = true;
+        return true;
+    }
+    value = negative ? static_cast<long long>(0ULL - magnitude) : static_cast<long long>(magnitude);
+    return true;
+}
+
+bool AsciiReader::parse_real(double& value, bool& too_large, bool& finite) const
+{
+    const char* begin = m_token.c_str();
+    const char* end_of_token = begin + m_token.size();
+    too_large = false;
+    finite = true;
+
+    // strtod depends on the C locale's decimal point. A token with a comma is
+    // never a number in an MSH file; leave it to the "C"-locale parse below so
+    // that a comma locale cannot accept it.
+    if (m_token.find(',') == std::string::npos) {
+        char* end = nullptr;
+        errno = 0;
+        value = std::strtod(begin, &end);
+        if (end == end_of_token) {
+            if (errno == ERANGE && std::abs(value) == HUGE_VAL) {
+                too_large = true;
+            } else if (!std::isfinite(value)) {
+                finite = false; // nan, inf, infinity spelled out
+            }
+            return true;
+        }
+    }
+
+    // strtod stopped early: a malformed token, or a C locale whose decimal
+    // point is not '.'. iostreams parse with the classic locale, as the
+    // original reader did.
+    std::istringstream token(m_token);
+    token.imbue(std::locale::classic());
+    token >> value;
+    if (token.fail() || token.peek() != std::char_traits<char>::eof()) return false;
+    finite = std::isfinite(value);
+    return true;
+}
+
+std::string AsciiReader::int_kind(int min_value, int max_value)
+{
+    if (min_value == INT_MIN && max_value == INT_MAX) return "an integer";
+    if (max_value == INT_MAX) {
+        return min_value == 0 ? "a non-negative integer"
+                              : (min_value == 1 ? "a positive integer"
+                                                : "an integer >= " + std::to_string(min_value));
+    }
+    return "an integer from " + std::to_string(min_value) + " to " + std::to_string(max_value);
+}
+
+void AsciiReader::reject(Token token, bool too_large, const std::string& kind, const std::string& what)
+{
+    if (token == Token::EndOfInput) {
+        throw InvalidFormat(m_section + ": the file ends where " + what +
+                            " was expected (the section holds fewer values than its counts declare)");
+    }
+    const std::string where = describe_position(m_in, m_in.tellg(), m_section, nullptr);
+    if (token == Token::SectionMarker) {
+        throw InvalidFormat(where + m_token + " appears where " + what +
+                            " was expected (the section holds fewer values than its counts declare)");
+    }
+    if (too_large) {
+        throw InvalidFormat(where + "\"" + m_token + "\" is too large (" + what + ")");
+    }
+    // A number where an integer belongs (a coordinate read as a tag, say) is
+    // usually a value missing or left over earlier: every later value shifts.
+    std::string hint;
+    double ignored = 0;
+    bool ignored_large = false, ignored_finite = true;
+    if (kind.find("integer") != std::string::npos &&
+        parse_real(ignored, ignored_large, ignored_finite)) {
+        const std::string line = where.substr(0, where.find(','));
+        hint = "; if " + line + " looks right, a value is missing or extra before it";
+    }
+    throw InvalidFormat(where + "\"" + m_token + "\" is not " + kind + " (" + what + ")" + hint);
+}
+
+} // namespace mshio
