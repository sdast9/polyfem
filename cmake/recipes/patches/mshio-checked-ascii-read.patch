+std::string describe_position(
+    std::istream& in, std::streampos pos, const std::string& section, std::string* line_text)
+{
+    in.clear();
+    const std::streamoff end = static_cast<std::streamoff>(pos);
+    if (end < 0 || !in.seekg(0, std::ios::beg)) {
+        in.clear();
+        return section + ": ";
+    }
+
+    // 1 + the number of line breaks before `pos`; the line starts after the last one.
+    size_t line = 1;
+    std::streamoff offset = 0, line_start = 0;
+    char buffer[1 << 14];
+    while (offset < end) {
+        const std::streamsize wanted =
+            static_cast<std::streamsize>(std::min<std::streamoff>(sizeof(buffer), end - offset));
+        in.read(buffer, wanted);
+        const std::streamsize got = in.gcount();
+        if (got <= 0) break;
+        for (std::streamsize i = 0; i < got; i++) {
+            if (buffer[i] == '\n') {
+                line++;
+                line_start = offset + i + 1;
+            }
+        }
+        offset += got;
+    }
+
+    if (line_text != nullptr) {
+        in.clear();
+        in.seekg(line_start, std::ios::beg);
+        std::getline(in, *line_text);
+        if (!line_text->empty() && line_text->back() == '\r') line_text->pop_back();
+        constexpr size_t max_length = 160;
+        if (line_text->size() > max_length) line_text->replace(max_length, std::string::npos, "...");
+    }
+    in.clear();
+    return "line " + std::to_string(line) + ", " + section + ": ";
+}
