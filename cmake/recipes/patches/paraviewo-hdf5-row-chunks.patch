+		/// Write an N x c array (c > 1) in row blocks of about 1 MiB that span
+		/// every column. h5pp's default chunk guess is square (256 x 256 for an
+		/// N x 3 field), so each compressed chunk carries 85x more padding than
+		/// data and is inflated whole on every read: one 2.4M-point field took
+		/// 11 s to write and 2.7 s to read, against 0.4 s and 0.07 s here.
+		template <typename Derived>
+		void write_row_blocks(h5pp::File &file, const Eigen::MatrixBase<Derived> &data, const std::string &path)
+		{
+			const hsize_t rows = static_cast<hsize_t>(data.rows());
+			const hsize_t cols = static_cast<hsize_t>(data.cols());
+			if (rows == 0 || cols < 2)
+			{
+				file.writeDataset(data.derived(), path);
+				return;
+			}
+			const hsize_t row_bytes = cols * sizeof(typename Derived::Scalar);
+			const hsize_t chunk_rows = std::min<hsize_t>(rows, std::max<hsize_t>(1, (hsize_t(1) << 20) / row_bytes));
+			file.writeDataset(data.derived(), path, std::nullopt, H5D_CHUNKED,
+							  std::vector<hsize_t>{chunk_rows, cols},
+							  std::vector<hsize_t>{rows, cols});
+		}
+	} // namespace detail
 
